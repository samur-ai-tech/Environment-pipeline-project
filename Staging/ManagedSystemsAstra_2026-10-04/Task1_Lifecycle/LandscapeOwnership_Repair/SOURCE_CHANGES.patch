+def _landscape_export_identity(text, object_name, object_class, object_path, named_map):
+    """Read only the exact root object's explicit native T3D references.
+
+    This consumes ObjectExporterT3D diagnostic output, not an imported scene.
+    The native exporter may serialize same-package actor references relative to
+    its map. Resolve only that exact package context, never search actor labels.
+    Missing, duplicate, nested-only or ambiguous identity fails closed.
+    """
+    depth=0;roots=0;values={}
+    for raw in text.splitlines():
+        line=raw.strip()
+        if not line:continue
+        if line.startswith('Begin Object '):
+            if depth==0:
+                roots+=1
+                pairs=[(key,quoted or bare) for key,quoted,bare in
+                       re.findall(r'(\w+)=(?:"([^"]*)"|(\S+))',line)]
+                fields=dict(pairs)
+                if len(fields)!=len(pairs):raise RuntimeError('Duplicate native export root identity fields')
+                if fields.get('Name')!=object_name or fields.get('Class')!=object_class:
+                    raise RuntimeError('Native export root identity differs from the official output object')
+                if fields.get('ExportPath')!=object_class+"'"+object_path+"'":
+                    raise RuntimeError('Native export lacks the exact official output object path')
+            depth+=1
+        elif line=='End Object':
+            depth-=1
+            if depth<0:raise RuntimeError('Unbalanced native object export')
+        elif '=' in line:
+            key,value=line.split('=',1)
+            if key not in ('Landscape','LandscapeProxy'):continue
+            if depth!=1:raise RuntimeError('Nested or unscoped native Landscape reference')
+            if key in values:raise RuntimeError('Duplicate native Landscape reference: '+key)
+            value=value.strip()
+            if value.startswith('"') and value.endswith('"'):value=value[1:-1]
+            match=re.fullmatch(r"(?:/Script/Landscape\.)?Landscape'(.+)'",value)
+            if not match:raise RuntimeError('Native Landscape reference is missing or not an explicit actor identity: '+key)
+            path=match.group(1)
+            if path.startswith('"') or path.endswith('"'):
+                if not (path.startswith('"') and path.endswith('"')):raise RuntimeError('Unbalanced native actor reference quoting')
+                path=path[1:-1]
+            local_prefix=named_map.rsplit('/',1)[-1]+':PersistentLevel.'
+            if path.startswith(local_prefix):
+                path=named_map+'.'+path
+            expected_prefix=named_map+'.'+local_prefix
+            if not path.startswith(expected_prefix) or not re.fullmatch(r'[A-Za-z0-9_]+',path[len(expected_prefix):]):
+                raise RuntimeError('Native actor reference is outside its exact named-map package context')
+            values[key]=path
+        elif depth==0:
+            raise RuntimeError('Unexpected text outside native export root')
+    if roots!=1 or depth!=0 or 'Landscape' not in values:
+        raise RuntimeError('Native export has no unique complete Landscape identity')
+    if 'LandscapeProxy' in values and values['LandscapeProxy']!=values['Landscape']:
+        raise RuntimeError('Native parent/proxy bindings differ; partitioned Landscape ownership requires review')
+    return values['Landscape']
 

+def _retirement_history(previous, prior_state, retiring_failed):
+    """Keep historical ledgers across replacements; never use them for deletion."""
+    failed, successful, meshes = {}, {}, set()
+    for receipt in (previous or {}, prior_state or {}):
+        for row in receipt.get('retired_failed_generations', []):
+            failed[_sha(row)] = _read(row)
+        for row in receipt.get('retired_successful_generations', []):
+            successful[_sha(row)] = _read(row)
+        meshes.update(receipt.get('unvalidated_previous_mesh_packages_preserved', []))
+    for row in retiring_failed:
+        failed[_sha(row)] = _read(row)
+    for row in failed.values():
+        meshes.update(row.get('unvalidated_mesh_paths', []))
+    if previous:
+        keys = ('revision', 'area_id', 'named_map', 'source_sha256', 'centreline_sha256',
+                'network_actor_path', 'road_actor_paths', 'geometry_actor_paths',
+                'owned_actor_paths', 'named_generated_dependency_paths')
+        row = _read({key: previous[key] for key in keys if key in previous})
+        successful[_sha(row)] = row
+    return {'retired_failed_generations': list(failed.values()),
+            'retired_successful_generations': list(successful.values()),
+            'unvalidated_previous_mesh_packages_preserved': sorted(meshes)}
 
 

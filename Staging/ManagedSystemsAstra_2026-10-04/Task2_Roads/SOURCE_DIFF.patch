+def inspect_geographic_landscape_authority():
+    """Read the installed config contract and both native settings views.
+
+    RoadBLDRuntimeSettings is Config=RoadBLD, not Config=Engine. Its
+    reflected Get() accessor is checked as well as the class default object;
+    neither a disk edit nor a CDO-only observation proves effective policy.
+    This function never sets defaults, reloads config, builds, or saves.
+    """
+    path = Path(__file__).resolve().parents[2] / NATIVE_SETTINGS_CONFIG
+    report = {'schema': 'environmentpipeline.roadbld_landscape_authority.v1',
+              'config_category': 'RoadBLD', 'project_config_path': str(path),
+              'settings_class': NATIVE_SETTINGS_CLASS, 'required_value': False,
+              'project_flags': {}, 'native_views': {}, 'errors': [], 'passed': False}
+    try:
+        raw = path.read_bytes()
+        report['project_config_sha256'] = hashlib.sha256(raw).hexdigest()
+        config = configparser.RawConfigParser(strict=False)
+        config.read_string(raw.decode('utf-8-sig'))
+        report['project_flags'] = {name: config.getboolean(NATIVE_SETTINGS_CLASS, name)
+                                   for name in NATIVE_LANDSCAPE_EDIT_FLAGS}
+        if any(report['project_flags'].values()):
+            report['errors'].append('Project RoadBLD configuration permits terrain writes')
+    except Exception as exc:
+        report['errors'].append('Project RoadBLD configuration: ' + repr(exc))
+    try:
+        cdo = unreal.get_default_object(unreal.RoadBLDRuntimeSettings)
+        for label, settings in (('class_default', cdo), ('native_get', _call(cdo, 'Get'))):
+            if settings is None or _path(settings.get_class()) != NATIVE_SETTINGS_CLASS:
+                raise RuntimeError('Unexpected native settings object: ' + label)
+            flags = {name: _get(settings, name) for name in NATIVE_LANDSCAPE_EDIT_FLAGS}
+            report['native_views'][label] = {'object_path': _path(settings), 'flags': flags}
+            if not all(value is False for value in flags.values()):
+                report['errors'].append(label + ' does not confirm all five terrain-write flags False')
+    except Exception as exc:
+        report['errors'].append('Effective native RoadBLD configuration: ' + repr(exc))
+    report['passed'] = not report['errors'] and len(report['native_views']) == 2
+    return report
+

(fn UpdateSky ()
(Variables|06Weather|SetCloudAmount (Math|Float|Clamp(Float) (Variables|06Weather|GetCloudAmount) 0.0 1.0))
(Variables|06Weather|SetHaze (Math|Float|Clamp(Float) (Variables|06Weather|GetHaze) 0.0 1.0))
(bind normalized (select (>= (Variables|01TimeandSun|GetTimeOfDay) 24.0) 0.0 (Math|Float|Clamp(Float) (Variables|01TimeandSun|GetTimeOfDay) 0.0 24.0)))
(Variables|01TimeandSun|SetTimeOfDay normalized)
(bind hours (Math|Float|Truncate normalized))
(bind minutes (Math|Float|Truncate (+ (* (- normalized hours) 60.0) 0.0001)))
(Variables|01TimeandSun|SetClockDisplay (Utilities|String|Append (Utilities|String|Append (Utilities|String|ToString(Text) (Utilities|Text|ToText(Integer) :Value hours :bUseGrouping false :MinimumIntegralDigits 2 :MaximumIntegralDigits 2)) ":") (Utilities|String|ToString(Text) (Utilities|Text|ToText(Integer) :Value minutes :bUseGrouping false :MinimumIntegralDigits 2 :MaximumIntegralDigits 2))))
(Variables|00Activation|SetConflictActors "")
(bind actors (Actor|GetAllActorsOfClass :ActorClass "/Script/Engine.Actor"))
(for other actors (if (!= other self)
(for component (Actor|GetComponentsByClass :self other :ComponentClass "/Script/Engine.DirectionalLightComponent")
(bind sceneComponent (Utilities|Casting|CastToSceneComponent :Object component)
(:then (if (Rendering|IsVisible :self sceneComponent) (Variables|00Activation|SetConflictActors (Utilities|String|Append (Variables|00Activation|GetConflictActors) (Utilities|String|Append (Utilities|GetDisplayName :Object other) "; ")))))
(:CastFailed)))
(for component (Actor|GetComponentsByClass :self other :ComponentClass "/Script/Engine.SkyLightComponent")
(bind sceneComponent (Utilities|Casting|CastToSceneComponent :Object component)
(:then (if (Rendering|IsVisible :self sceneComponent) (Variables|00Activation|SetConflictActors (Utilities|String|Append (Variables|00Activation|GetConflictActors) (Utilities|String|Append (Utilities|GetDisplayName :Object other) "; ")))))
(:CastFailed)))
(for component (Actor|GetComponentsByClass :self other :ComponentClass "/Script/Engine.SkyAtmosphereComponent")
(bind sceneComponent (Utilities|Casting|CastToSceneComponent :Object component)
(:then (if (Rendering|IsVisible :self sceneComponent) (Variables|00Activation|SetConflictActors (Utilities|String|Append (Variables|00Activation|GetConflictActors) (Utilities|String|Append (Utilities|GetDisplayName :Object other) "; ")))))
(:CastFailed)))
(for component (Actor|GetComponentsByClass :self other :ComponentClass "/Script/Engine.VolumetricCloudComponent")
(bind sceneComponent (Utilities|Casting|CastToSceneComponent :Object component)
(:then (if (Rendering|IsVisible :self sceneComponent) (Variables|00Activation|SetConflictActors (Utilities|String|Append (Variables|00Activation|GetConflictActors) (Utilities|String|Append (Utilities|GetDisplayName :Object other) "; ")))))
(:CastFailed)))
))
(Variables|Default|SetCanRender (and (Variables|00Activation|GetRigEnabled) (Utilities|String|IsEmpty (Variables|00Activation|GetConflictActors))))
(if (Variables|01TimeandSun|GetManualSun)
(Variables|Location|SetCorrectedElevation (+ 180.0 (Math|Float|Clamp(Float) :Value (Variables|03ManualSun|GetManualElevation) :Min -90.0 :Max 90.0)))
(Variables|Location|SetAzimuth (Variables|03ManualSun|GetManualDirection))
(else
(bind year (Math|Integer|Clamp(Integer) :Value (Variables|02DateLocationandNorth|GetYear) :Min 1 :Max 9999))
(bind month (Math|Integer|Clamp(Integer) :Value (Variables|02DateLocationandNorth|GetMonth) :Min 1 :Max 12))
(bind day (Math|Integer|Clamp(Integer) :Value (Variables|02DateLocationandNorth|GetDay) :Min 1 :Max (Math|DateTime|DaysInMonth year month)))
(bind solar (SunPosition|GetSunPosition :Latitude (Math|Float|Clamp(Float) (Variables|02DateLocationandNorth|GetLatitude) -90.0 90.0) :Longitude (Math|Float|Clamp(Float) (Variables|02DateLocationandNorth|GetLongitude) -180.0 180.0) :TimeZone (Math|Float|Clamp(Float) (Variables|02DateLocationandNorth|GetTimeZone) -12.0 14.0) :bIsDaylightSavingTime (Variables|02DateLocationandNorth|GetUseDaylightSavingTime) :Year year :Month month :Day day :Hours hours :Minutes minutes :Seconds 0))
(bind (elevation corrected azimuth sunrise sunset solarNoon) (Utilities|Struct|BreakSunPositionData solar))
(Variables|Location|SetCorrectedElevation corrected)
(Variables|Location|SetAzimuth azimuth)
))
(Transformation|SetWorldRotation :self (Variables|Default|GetDirectionalLight) :NewRotation (Math|Rotator|MakeRotator :Pitch (Variables|Location|GetCorrectedElevation) :Yaw (+ (Variables|Location|GetAzimuth) (Variables|02DateLocationandNorth|GetNorthOffset))))
(Transformation|SetWorldRotation :self (Variables|Default|GetNorthArrow) :NewRotation (Math|Rotator|MakeRotator :Yaw (Variables|02DateLocationandNorth|GetNorthOffset)))
(Transformation|SetWorldRotation :self (Variables|Default|GetCompassMesh) :NewRotation (Math|Rotator|MakeRotator :Yaw (+ (Variables|02DateLocationandNorth|GetNorthOffset) 90.0)))
(Rendering|SetVisibility :self (Variables|Default|GetDirectionalLight) :bNewVisibility (Variables|Default|GetCanRender))
(Rendering|SetVisibility :self (Variables|Default|GetSkyLight) :bNewVisibility (Variables|Default|GetCanRender))
(Rendering|SetVisibility :self (Variables|Default|GetSkyAtmosphere) :bNewVisibility (Variables|Default|GetCanRender))
(Rendering|Components|Light|SetIntensity :self (Variables|Default|GetDirectionalLight) :NewIntensity (select (> (Variables|Location|GetCorrectedElevation) 180.0) (* (Math|Float|Clamp(Float) (Variables|04Lighting|GetSunIntensity) 0.0 200000.0) (- 1.0 (* 0.88 (* (Variables|06Weather|GetCloudAmount) (* (Variables|06Weather|GetCloudAmount) (Variables|06Weather|GetCloudAmount)))))) 0.0))
(Rendering|Components|SkyLight|SetIntensity :self (Variables|Default|GetSkyLight) :NewIntensity (* (Math|Float|Clamp(Float) (Variables|04Lighting|GetSkyIntensity) 0.0 20.0) (- 1.0 (* 0.15 (Variables|06Weather|GetCloudAmount)))))
(Class|PostProcessComponent|SetEnabled :self (Variables|Default|GetExposureOverride) :bEnabled (and (Variables|Default|GetCanRender) (Variables|05Exposure|GetOverrideExposure)))
(Class|PostProcessComponent|SetBlendWeight :self (Variables|Default|GetExposureOverride) :BlendWeight (select (and (Variables|Default|GetCanRender) (Variables|05Exposure|GetOverrideExposure)) 1.0 0.0))
(if (not (Utilities|String|IsEmpty (Variables|00Activation|GetConflictActors)))
(Variables|00Activation|SetStatus "Lighting conflict: existing actors preserved; rig inactive. See Conflict Actors.")
(else (if (Variables|Default|GetCanRender)
(Variables|00Activation|SetStatus (select (Variables|01TimeandSun|GetManualSun) "Active - Manual Sun" "Active - Time and Location"))
(else (Variables|00Activation|SetStatus "Inactive - enable Rig Enabled after resolving lighting conflicts.")))))
(Variables|00Activation|SetRuntimeNotes "Runtime: call UpdateSky after changing controls. Automatic time animation is off. Invalid date inputs are clamped for the solar solver.")

(Utilities|IsValid (Variables|Default|GetCloudMID) (:"Is Valid" (CallFunction|ApplyWeather)) (:"Is Not Valid" (Variables|Default|SetCloudMID (Rendering|Material|CreateDynamicMaterialInstance :Parent "/Game/Project/Shared/Atmosphere/ReusableSky/MI_EnvironmentCloudDefaults.MI_EnvironmentCloudDefaults" :OptionalName "EnvironmentCloudMID" :CreationFlags "Transient")) (CallFunction|ApplyWeather)))
)
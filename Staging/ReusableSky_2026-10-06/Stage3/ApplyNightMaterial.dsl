(fn ApplyNightMaterial ()
(Rendering|Material|SetMaterial :self (Variables|Default|GetCelestialDome) :ElementIndex 0 :Material (Variables|Default|GetCelestialMID))
(Rendering|SetVisibility :self (Variables|Default|GetCelestialDome) :bNewVisibility (Variables|Default|GetCanRender))
(bind moonHorizon (Math|Float|Clamp(Float) (/ (- 0.0 (Variables|13Readback|GetSunElevation)) 5.0) 0.0 1.0))
(bind moonFade (* moonHorizon (* moonHorizon (- 3.0 (* 2.0 moonHorizon)))))
(bind starT (Math|Float|Clamp(Float) (/ (- (- 0.0 (Variables|13Readback|GetSunElevation)) 4.0) 8.0) 0.0 1.0))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "MoonLuminance" :Value (select (Variables|09Moon|GetMoonEnabled) (* (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonDiskBrightness) 0.0 100.0) (* (Variables|13Readback|GetNightBlend) moonFade)) 0.0))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "MoonPhase" :Value (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonPhase) 0.0 1.0))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "MoonDiameter" :Value (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonAngularDiameter) 0.1 10.0))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "StarLuminance" :Value (select (Variables|10Stars|GetStarsEnabled) (* (Math|Float|Clamp(Float) (Variables|10Stars|GetStarBrightness) 0.0 100.0) (* starT (* starT (- 3.0 (* 2.0 starT))))) 0.0))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "NorthRadians" :Value (* (Variables|02DateLocationandNorth|GetNorthOffset) 0.01745329252))
(bind (mx my mz) (Math|Vector|BreakVector (Transformation|GetForwardVector :self (Variables|Default|GetMoonLight))))
(Rendering|Material|SetVectorParameterValue :self (Variables|Default|GetCelestialMID) :ParameterName "MoonDirection" :Value (Math|Color|MakeColor :R (- 0.0 mx) :G (- 0.0 my) :B (- 0.0 mz) :A 1.0))
)
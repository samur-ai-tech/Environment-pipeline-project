(fn ApplyWeather ()
(Rendering|SetMaterial :self (Variables|Default|GetWeatherClouds) :NewValue (Variables|Default|GetCloudMID))
(Rendering|SetVisibility :self (Variables|Default|GetWeatherClouds) :bNewVisibility (and (Variables|Default|GetCanRender) (> (Variables|06Weather|GetCloudAmount) 0.001)))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCloudMID) :ParameterName "Cloud_GlobalCoverage" :Value (+ -1.0 (* 2.5 (* (Variables|06Weather|GetCloudAmount) (Variables|06Weather|GetCloudAmount)))))
(Rendering|Material|SetScalarParameterValue :self (Variables|Default|GetCloudMID) :ParameterName "Cloud_GlobalDensity" :Value (+ 0.006 (* 0.012 (Variables|06Weather|GetCloudAmount))))
(bind windAngle (+ (Variables|07CloudMotion|GetCloudDirection) (Variables|02DateLocationandNorth|GetNorthOffset)))
(bind windSpeed (Math|Float|Clamp(Float) (Variables|07CloudMotion|GetCloudSpeed) 0.0 20.0))
(Rendering|Material|SetVectorParameterValue :self (Variables|Default|GetCloudMID) :ParameterName "Layout_WindControls" :Value (Math|Color|MakeColor :R (Math|Trig|Cos(Degrees) windAngle) :G (Math|Trig|Sin(Degrees) windAngle) :B 0.0 :A (* 0.333333 windSpeed)))
(Rendering|SetMieScatteringScale :self (Variables|Default|GetSkyAtmosphere) :NewValue (+ 0.002 (* 0.022 (Variables|06Weather|GetHaze))))
(Rendering|Lighting|SetLightSourceAngle :self (Variables|Default|GetDirectionalLight) :NewValue (+ 0.5357 (* 4.0 (* (Variables|06Weather|GetCloudAmount) (* (Variables|06Weather|GetCloudAmount) (Variables|06Weather|GetCloudAmount))))))
(Rendering|SetViewSampleCountScale :self (Variables|Default|GetWeatherClouds) :NewValue (select (Variables|08Quality|GetHighQuality) 2.0 1.0))
(Rendering|SetReflectionViewSampleCountScale :self (Variables|Default|GetWeatherClouds) :NewValue (select (Variables|08Quality|GetHighQuality) 1.0 0.5))
(Rendering|SetShadowViewSampleCountScale :self (Variables|Default|GetWeatherClouds) :NewValue (select (Variables|08Quality|GetHighQuality) 1.0 0.5))
(Rendering|SetShadowReflectionViewSampleCountScale :self (Variables|Default|GetWeatherClouds) :NewValue (select (Variables|08Quality|GetHighQuality) 0.5 0.25))
(Class|PostProcessComponent|SetSettings :self (Variables|Default|GetExposureOverride) :Settings (Variables|05Exposure|GetExposureSettings))
(Rendering|SetVisibility :self (Variables|Default|GetNorthArrow) :bNewVisibility true)

(CallFunction|UpdateNight)
)
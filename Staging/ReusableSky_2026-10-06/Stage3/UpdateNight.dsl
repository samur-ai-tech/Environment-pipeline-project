(fn UpdateNight ()
(Variables|13Readback|SetSunElevation (- (Variables|Location|GetCorrectedElevation) 180.0))
(bind nightT (Math|Float|Clamp(Float) (/ (- 2.0 (Variables|13Readback|GetSunElevation)) 12.0) 0.0 1.0))
(Variables|13Readback|SetNightBlend (* nightT (* nightT (- 3.0 (* 2.0 nightT)))))
(bind sunT (Math|Float|Clamp(Float) (/ (Variables|13Readback|GetSunElevation) 4.0) 0.0 1.0))
(bind cloudCube (* (Variables|06Weather|GetCloudAmount) (* (Variables|06Weather|GetCloudAmount) (Variables|06Weather|GetCloudAmount))))
(Rendering|Components|Light|SetIntensity :self (Variables|Default|GetDirectionalLight) :NewIntensity (* (Math|Float|Clamp(Float) (Variables|04Lighting|GetSunIntensity) 0.0 200000.0) (* (* sunT (* sunT (- 3.0 (* 2.0 sunT)))) (- 1.0 (* 0.88 cloudCube)))))
(Rendering|Components|SkyLight|SetIntensity :self (Variables|Default|GetSkyLight) :NewIntensity (* (Math|Float|Clamp(Float) (Variables|04Lighting|GetSkyIntensity) 0.0 20.0) (* (- 1.0 (* 0.15 (Variables|06Weather|GetCloudAmount))) (+ (- 1.0 (Variables|13Readback|GetNightBlend)) (* (Variables|13Readback|GetNightBlend) (Math|Float|Clamp(Float) (Variables|12NightAdvanced|GetNightSkyFill) 0.0 1.0))))))
(Transformation|SetWorldRotation :self (Variables|Default|GetMoonLight) :NewRotation (Math|Rotator|MakeRotator :Pitch (- 180.0 (Variables|13Readback|GetSunElevation)) :Yaw (+ 180.0 (+ (Variables|Location|GetAzimuth) (Variables|02DateLocationandNorth|GetNorthOffset)))))
(Rendering|SetVisibility :self (Variables|Default|GetMoonLight) :bNewVisibility (and (Variables|Default|GetCanRender) (Variables|09Moon|GetMoonEnabled)))
(bind moonT (Math|Float|Clamp(Float) (/ (- 0.0 (Variables|13Readback|GetSunElevation)) 5.0) 0.0 1.0))
(bind phaseLight (* 0.5 (- 1.0 (Math|Trig|Cos(Degrees) (* 360.0 (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonPhase) 0.0 1.0))))))
(Rendering|Components|Light|SetIntensity :self (Variables|Default|GetMoonLight) :NewIntensity (select (Variables|09Moon|GetMoonEnabled) (* (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonBrightness) 0.0 10.0) (* (Variables|13Readback|GetNightBlend) (* (* moonT (* moonT (- 3.0 (* 2.0 moonT)))) (* phaseLight (- 1.0 (* 0.7 (Variables|06Weather|GetCloudAmount))))))) 0.0))
(Rendering|Components|Light|SetLightColor :self (Variables|Default|GetMoonLight) :NewLightColor (Math|Color|MakeColor :R 0.64 :G 0.74 :B 1.0 :A 1.0))
(Rendering|Lighting|SetLightSourceAngle :self (Variables|Default|GetMoonLight) :NewValue (Math|Float|Clamp(Float) (Variables|09Moon|GetMoonAngularDiameter) 0.1 10.0))
(Actor|Tick|SetActorTickInterval :TickInterval 0.1)
(Actor|Tick|SetActorTickEnabled :bEnabled (and (Variables|Default|GetCanRender) (and (Variables|11TimeProgression|GetAnimateTime) (not (Variables|11TimeProgression|GetTimePaused)))))
(Utilities|IsValid (Variables|Default|GetCelestialMID) (:"Is Valid" (CallFunction|ApplyNightMaterial)) (:"Is Not Valid" (Variables|Default|SetCelestialMID (Rendering|Material|CreateDynamicMaterialInstance :Parent "/Game/Project/Shared/Atmosphere/ReusableSky/M_EnvironmentCelestial.M_EnvironmentCelestial" :OptionalName "EnvironmentCelestialMID" :CreationFlags "Transient")) (CallFunction|ApplyNightMaterial)))

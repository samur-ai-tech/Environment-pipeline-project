 "functions": {
  "MF_GeoCity_MacroNoise": {
   "inputs": [
    "NoiseTex:Texture2D",
    "LandscapeUV:Vector2",
    "TileNearCm:Scalar",
    "TileFarCm:Scalar",
    "GridCm:Scalar"
   ],
   "outputs": [
    "NoiseNear:V3",
    "NoiseFar:V3"
   ],
   "texture_samples": 2,
   "sampler_type": "SAMPLERTYPE_MASKS",
   "sampler_source": "SSM_WRAP_WORLD_GROUP_SETTINGS",
   "math": "NN=T(UV*Grid/TileNear); NF=T(rot30deg(UV)*Grid/TileFar+(0.37,0.61)); constants only, 0 parameter expressions"
  },
  "MF_GeoCity_DistanceBlend": {
   "inputs": [
    "Tex:Texture2D",
    "NearUV:Vector2",
    "FarScale:Scalar",
    "Alpha:Scalar"
   ],
   "outputs": [
    "Color:V3"
   ],
   "texture_samples": 2,
   "sampler_type": "SAMPLERTYPE_COLOR",
   "sampler_source": "SSM_WRAP_WORLD_GROUP_SETTINGS",
   "math": "lerp(T(NearUV), T(NearUV/max(FarScale,1)), saturate(Alpha))"
  },
  "MF_GeoCity_MacroColor": {
   "inputs": [
    "Base:V3",
    "NoiseNear:V3",
    "NoiseFar:V3",
    "HueA:V3",
    "HueB:V3",
    "HueAmount:S",
    "ValueAmount:S",
    "DistanceAlpha:S",
    "FarSaturation:S",
    "FarValue:S",
    "FarAmount:S"
   ],
   "outputs": [
    "Color:V3"
   ],
   "texture_samples": 0,
   "math": "zone=smoothstep(.35,.65,NF.r); tint=lerp(1,lerp(HueA,HueB,zone),HueAmount); v=1+ValueAmount*((NN.g+NF.g)-1); c=Base*tint*v; l=dot(c,(.2126,.7152,.0722)); cf=lerp(l,c,FarSaturation)*FarValue; out=saturate(lerp(c,cf,saturate(DistanceAlpha*FarAmount)))"
  },
  "MF_GeoCity_SlopeBlend": {
   "inputs": [
    "SteepWeight:S",
    "NormalZ:S",
    "Noise:S",
    "Lo:S",
    "Hi:S",
    "Jitter:S",
    "SlopeMix:S"
   ],
   "outputs": [
    "Alpha:S"
   ],
   "texture_samples": 0,
   "math": "slopeW=saturate((0.96593-NormalZ)/0.14678) [15..35 deg like MOD:5133-5137]; d=lerp(SteepWeight,slopeW,SlopeMix)+Jitter*(Noise-0.5); Alpha=smoothstep(Lo,Hi,d)"
  },
  "MF_GeoCity_HeightBlend": {
   "inputs": [
    "Near:V3",
    "Far:V3",
    "Bias:S",
    "Contrast:S"
   ],
   "outputs": [
    "Height:S"
   ],
   "texture_samples": 0,
   "math": "saturate(Bias+Contrast*(dot(Near,L)-dot(Far,L))), L=(.2126,.7152,.0722)"
  }
 },

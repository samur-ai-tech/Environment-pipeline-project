{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
bindeach	[ 0	locks=0 ]	(	"off"	)
snippet	[ 0	locks=0 ]	(	"vector color = v@Cd;

for ( int i = 1; i <= chi('layers'); i++)
{
    string layernumber = itoa(i);
    int layerenable = chi('layerenable_' + layernumber);
    
    if ( layerenable == 1 )
    {
        string layername = chs('layername_' + layernumber);
        vector layercolor = chv('layercolor_' +layernumber);
        float layermask = volumesample(0, layername, @P);
        
        color = lerp(color, layercolor, layermask);
    }
}

v@Cd = color;

"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
vex_geometrygenerator	[ 0	locks=0 ]	(	"off"	)
vdb_signedflood	[ 0	locks=0 ]	(	"on"	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
layers	[ 0	locks=0 ]	(	[ layers	7 ] 	)
layerenable_1	[ 0	locks=0 ]	(	[ layerenable_1	0 ] 	)
layername_1	[ 0	locks=0 ]	(	[ layername_1	"" ] 	)
layercolor_1	[ 0	locks=0 ]	(	[ layercolor_1r	1 ] 	[ layercolor_1g	1 ] 	[ layercolor_1b	1 ] 	)
layerenable_2	[ 0	locks=0 ]	(	[ layerenable_2	0 ] 	)

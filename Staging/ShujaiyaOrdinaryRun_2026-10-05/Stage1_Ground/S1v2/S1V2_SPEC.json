   "Sand_02": "HeightBlend(Steep.Near, Steep.Far)",
   "Dirt_Path": "HeightBlend(Road.Near, Road.Far)",
   "Sand_Path": "HeightBlend(Pad.Near, Pad.Far)",
   "shared": "Bias/Contrast/Amount params; identical sources on all 3 LLBs"
  },
  "llbs": "3 new LandscapeLayerBlend (color/normal/roughness), layers Sand_01, Sand_02, Dirt_Path, Sand_Path, all LB_HEIGHT_BLEND, preview weight Sand_01=1",
  "final_color": "sat(lerp(macro, banded, contact_band)) with macro = MacroColor(llb_color, Value, HueT, ...); ContactSoil target = Road.Color*Dirt_Path_Tint",
  "final_normal": "normalize(lerp(llb_normal, (0,0,1), DistanceAlpha*NormalFade))",
  "final_roughness": "clamp(llb_rough + RoughVar*clamp(Fine,-2,2)*0.5 + contact_band*ContactRough, 0, 1)",

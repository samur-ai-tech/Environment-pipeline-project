   "sample_rules": "Shared:Wrap, TMVM_NONE (continuous UVs)",
   "body": [
    "w = LandscapeUV * GridCm (cm)",
    "uv1 = w / max(Tile1Cm,1) + (0.13, 0.71); uv2 = rot37(w) / max(Tile2Cm,1) + (0.37, 0.61); uv3 = rot71(w) / max(Tile3Cm,1) + (0.83, 0.29)",
    "rotation via dot with constant rows: cos37 = 0.79864, sin37 = 0.60182; cos71 = 0.32557, sin71 = 0.94552",
    "z1 = (R(uv1) - NoiseMean) * NoiseInvStd; z2 = (G(uv2) - NoiseMean) * NoiseInvStd; z3 = (B(uv3) - NoiseMean) * NoiseInvStd",
    "Value = 0.25*z1 + 0.35*z2 + 0.40*z3",
    "HueT = sat(0.5 + HueGain*(0.4*z2 + 0.6*z3))",
    "VariantB = sat(0.5 + VariantGain*(0.6*z1 + 0.4*z2))",
    "VariantC = sat(0.5 + VariantGain*(0.4*z1 - 0.6*z2))",
    "Fine = z1"
   ]
  },

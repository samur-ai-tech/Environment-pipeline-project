 "branch": {
  "macro_field": "MF_GeoCity_MacroField(NoiseTex=P.MacroNoise, LandscapeUV=layer_coords, GridCm=grid_cm, Tile1/2/3Cm=P.MacroTile1/2/3Cm, NoiseMean, NoiseInvStd, HueGain, VariantGain)",
  "hash_bundle": "NearHash0-3=near_hash0-3, FarHash0-3=far_hash0-3, NearWX/WY=near_wx/wy, FarWX/WY=far_wx/wy, DistanceAlpha=distance_alpha (shared by all 5 CellSample calls)",
  "uv_groundB": "layer_coords * (grid_cm / max(P.GroundB_TileCm, 1)) * GeoCity_PatternScale",
  "uv_groundC": "layer_coords * (grid_cm / max(P.GroundC_TileCm, 1)) * GeoCity_PatternScale",
  "uv_steep": "layer_coords * (grid_cm / max(mask_r(Sand_02_TileCm), 1)) * GeoCity_PatternScale",
  "cell_calls": {
   "GroundB": "CellSample(P.GroundB_Albedo, uv_groundB, P.GroundB_FarScale)",
   "GroundC": "CellSample(P.GroundC_Albedo, uv_groundC, P.GroundC_FarScale)",
   "Steep": "CellSample(Sand_02_Albedo, uv_steep, steep_far_scale)",
   "Road": "CellSample(Dirt_Path_Albedo, road_uv, road_far_scale)",
   "Pad": "CellSample(Sand_Path_Albedo, pad_uv, pad_far_scale)"
  },
  "ground_color": "lerp(lerp(ground_full, GroundB.Color*P.GroundB_Tint, VariantB*P.GroundB_Amount), GroundC.Color*P.GroundC_Tint, VariantC*P.GroundC_Amount)",
  "ground_normal": "ground_full_normal",
  "ground_rough": "Sand_01_Roughness",
  "steep_alpha": "MF_GeoCity_SlopeBlend(SteepWeight=LayerSample Sand_02, NormalZ=VertexNormalWS.b, Noise=sat(0.5+0.25*Fine), Lo, Hi, Jitter, SlopeMix)",
  "steep_color": "lerp(ground_color, Steep.Color*Sand_02_Tint, steep_alpha)",
  "steep_normal": "normalize(lerp(ground_normal, steep_normal, steep_alpha))",
  "steep_rough": "lerp(ground_rough, Sand_02_Roughness, steep_alpha)",
  "road": {
   "color": "Road.Color*Dirt_Path_Tint",
   "normal": "road_normal",
   "rough": "Dirt_Path_Roughness"
  },
  "pad": {

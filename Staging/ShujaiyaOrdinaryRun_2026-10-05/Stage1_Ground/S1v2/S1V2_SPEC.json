   "sample_rules": "Shared:Wrap, TMVM_DERIVATIVE, DDX(UVs)/DDY(UVs) connected",
   "body": [
    "dxn = DDX(NearUV); dyn = DDY(NearUV)",
    "fs = max(FarScale, 1); farUV = NearUV / fs; dxf = dxn / fs; dyf = dyn / fs",
    "n_i = SampleGrad(Tex, NearUV + NearHash_i, dxn, dyn), i = 0..3",
    "Near = lerp(lerp(n0, n1, NearWX), lerp(n2, n3, NearWX), NearWY)",
    "f_i = SampleGrad(Tex, farUV + FarHash_i, dxf, dyf), i = 0..3",
    "Far = lerp(lerp(f0, f1, FarWX), lerp(f2, f3, FarWX), FarWY)",
    "Color = lerp(Near, Far, sat(DistanceAlpha))"
   ]
  },
